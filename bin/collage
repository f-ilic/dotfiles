#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["textual==8.2.1", "pillow>=10.1"]
# ///
"""collage - lay out images, GIFs and videos in a grid or a stack, using ffmpeg.

Every input is scaled to fit one uniform cell (letterboxed, never cropped or
distorted); the result is written as a GIF, a video or a still image depending
on the output extension.  With no arguments it opens a small TUI.
"""

from __future__ import annotations

import argparse
import functools
import glob
import json
import math
import os
import re
import resource
import shlex
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import unicodedata
from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass
from pathlib import Path

IMAGE_EXTS = {".jpg", ".jpeg", ".png", ".webp", ".bmp", ".tif", ".tiff"}
GIF_EXTS = {".gif"}
VIDEO_EXTS = {".mp4", ".mov", ".mkv", ".webm", ".avi", ".m4v"}
IMAGE_OUT = {".png", ".jpg", ".jpeg", ".webp"}
VIDEO_OUT = {".mp4", ".mov", ".webm", ".mkv"}

CELL_HEIGHT = {"image": 360, "gif": 240, "video": 240}  # default --height per output kind
FPS = {"gif": 15, "video": 30}  # default --fps per output kind
STILL_HOLD = 3.0  # seconds a still lasts in animated output when nothing else sets the length
FONTS = (
    "/System/Library/Fonts/Supplemental/Arial.ttf",
    "/System/Library/Fonts/Helvetica.ttc",
    "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
    "/usr/share/fonts/dejavu/DejaVuSans.ttf",
    "/usr/share/fonts/TTF/DejaVuSans.ttf",
)
INSTALL_HINT = "install it with 'brew install ffmpeg' (macOS) or 'sudo apt install ffmpeg' (Ubuntu)"

DESCRIPTION = """\
Lay out images, GIFs and videos in a grid or a stack.

Each input is scaled to fit a uniform cell (letterboxed, never cropped or
distorted) and labelled with its file name.  The output type follows the -o
extension: .gif, a video (.mp4 .mov .webm .mkv) or an image (.png .jpg .webp).
Without -o it is collage.png (only stills), collage.mp4 (any video) or
collage.gif.  Explicit INPUT files keep the order you give; the contents of a
directory are sorted naturally (2 before 10).  Audio is dropped.
"""

EXAMPLES = """\
examples:
  collage *.gif -o grid.gif                     grid of GIFs, 4 columns
  collage -H before.mp4 after.mp4 --caption Before --caption After -o compare.mp4
                                                side-by-side comparison with captions
  collage --cols 6 --height 200 ~/Photos/trip -o sheet.jpg
                                                contact sheet of a photo folder
  collage -V a.mp4 b.mov c.mp4 -o stack.mp4     vertical stack of videos
  collage -r clips/ --rows 2 --no-labels --shortest
                                                every GIF/video under clips/, 2 rows
  collage                                       open the TUI
"""


class CollageError(Exception):
    """A runtime failure: reported as one line, exit code 1."""


class UsageError(Exception):
    """A bad command line: reported with the usage line, exit code 2."""


# --------------------------------------------------------------------------
# Reporting (the CLI and the TUI each provide their own UI)
# --------------------------------------------------------------------------


class UI:
    """Where the engine reports to; the base class ignores everything."""

    cancelled = False

    def info(self, message: str) -> None: ...

    def warn(self, message: str) -> None: ...

    def progress(self, label: str, fraction: float) -> None: ...

    def confirm(self, question: str) -> bool:
        return False


class ConsoleUI(UI):
    def __init__(self) -> None:
        self._tty = sys.stderr.isatty()
        self._bar_open = False

    def _close_bar(self) -> None:
        if self._bar_open:
            print(file=sys.stderr)
            self._bar_open = False

    def info(self, message: str) -> None:
        self._close_bar()
        print(message)

    def warn(self, message: str) -> None:
        self._close_bar()
        print(f"collage: warning: {message}", file=sys.stderr)

    def progress(self, label: str, fraction: float) -> None:
        if not self._tty:
            if fraction == 0:
                print(f"{label}...")
            return
        filled = int(fraction * 20)
        bar = "#" * filled + "." * (20 - filled)
        print(f"\r{label}: [{bar}] {fraction:4.0%}", end="", file=sys.stderr, flush=True)
        self._bar_open = True

    def confirm(self, question: str) -> bool:
        if not sys.stdin.isatty():
            return False
        try:
            return input(f"{question} [y/N] ").strip().lower() in ("y", "yes")
        except EOFError:
            return False


# --------------------------------------------------------------------------
# Command line
# --------------------------------------------------------------------------


class Parser(argparse.ArgumentParser):
    def error(self, message: str):
        raise UsageError(message)


def positive_int(text: str) -> int:
    if not text.isdecimal() or int(text) < 1:
        raise argparse.ArgumentTypeError(f"expected a positive whole number, got {text!r}")
    return int(text)


def non_negative_int(text: str) -> int:
    if not text.isdecimal():
        raise argparse.ArgumentTypeError(f"expected a whole number, got {text!r}")
    return int(text)


def quality_value(text: str) -> int:
    if not text.isdecimal() or not 1 <= int(text) <= 100:
        raise argparse.ArgumentTypeError(f"expected a number from 1 to 100, got {text!r}")
    return int(text)


def cell_size(text: str) -> tuple[int, int]:
    match = re.fullmatch(r"(\d+)x(\d+)", text.lower())
    if not match or 0 in map(int, match.groups()):
        raise argparse.ArgumentTypeError(f"expected WIDTHxHEIGHT such as 320x240, got {text!r}")
    return int(match[1]), int(match[2])


def color_value(text: str) -> str:
    if not re.fullmatch(r"[A-Za-z]+|(#|0x)[0-9A-Fa-f]{6}", text):
        raise argparse.ArgumentTypeError(f"expected a colour name or #RRGGBB, got {text!r}")
    return text


def build_parser() -> Parser:
    parser = Parser(
        prog="collage",
        usage="collage [options] INPUT... [-o OUTPUT]",
        description=DESCRIPTION,
        epilog=EXAMPLES,
        formatter_class=lambda prog: argparse.RawDescriptionHelpFormatter(prog, max_help_position=28),
        allow_abbrev=False,
        add_help=False,
    )
    inputs = parser.add_argument_group("input")
    inputs.add_argument("inputs", nargs="*", metavar="INPUT", help="files and/or directories (a directory expands to the media inside it; quoted globs work too)")
    inputs.add_argument("-r", "--recursive", action="store_true", help="expand directories (and ** globs) recursively")

    layout = parser.add_argument_group("layout")
    shape = layout.add_mutually_exclusive_group()
    shape.add_argument("-H", "--horizontal", action="store_true", help="one row (side by side)")
    shape.add_argument("-V", "--vertical", action="store_true", help="one column (stacked)")
    layout.add_argument("--cols", type=positive_int, metavar="N", help="columns; rows are derived (default: min(inputs, 4))")
    layout.add_argument("--rows", type=positive_int, metavar="N", help="rows; columns are derived")
    layout.add_argument("--height", type=positive_int, metavar="PX", help="cell height; the width follows the first input (default: 240 for GIF/video, 360 for images)")
    layout.add_argument("--cell", type=cell_size, metavar="WxH", help="exact cell size, overrides --height")
    layout.add_argument("--gap", type=non_negative_int, default=4, metavar="PX", help="space between cells, rounded up to even (default: 4)")
    layout.add_argument("--bg", type=color_value, default="black", metavar="COLOR", help="background, letterbox and gap colour (default: black)")

    labels = parser.add_argument_group("labels")
    labels.add_argument("--no-labels", action="store_true", help="do not label cells with the file name")
    labels.add_argument("--caption", action="append", default=[], metavar="TEXT", help="label text, matched to the inputs in order (repeatable; '' hides one label)")

    timing = parser.add_argument_group("timing and quality")
    timing.add_argument("--fps", type=positive_int, metavar="N", help="frame rate (default: 15 for GIF, 30 for video)")
    timing.add_argument("--shortest", action="store_true", help="end with the shortest input (default: run to the longest, shorter ones hold their last frame)")
    timing.add_argument("--quality", type=quality_value, default=70, metavar="1-100", help="GIF quality (default: 70)")

    output = parser.add_argument_group("output")
    output.add_argument("-o", "--output", metavar="FILE", help="output file; its extension picks GIF, video or image")
    output.add_argument("-y", "--force", action="store_true", help="overwrite an existing output (asks when run in a terminal)")
    output.add_argument("--dry-run", action="store_true", help="print the ffmpeg command(s) and exit without writing")

    other = parser.add_argument_group("other")
    other.add_argument("--tui", action="store_true", help="open the TUI (also the default when run without arguments)")
    other.add_argument("-h", "--help", action="help", help="show this help and exit")
    return parser


def parse_args(argv: list[str]) -> argparse.Namespace:
    """Parse and cross-check a command line; raises UsageError instead of exiting."""
    # Everything after '--' is an input, even if it starts with '-'.  Split it off here because
    # argparse's intermixed parsing mishandles '--' before Python 3.12.
    cut = argv.index("--") if "--" in argv else len(argv)
    args = build_parser().parse_intermixed_args(argv[:cut])
    args.inputs += argv[cut + 1 :]
    if (args.horizontal or args.vertical) and (args.cols or args.rows):
        raise UsageError("-H/--horizontal and -V/--vertical cannot be combined with --cols/--rows")
    if args.no_labels and args.caption:
        raise UsageError("--caption has no effect together with --no-labels")
    return args


# --------------------------------------------------------------------------
# Inputs
# --------------------------------------------------------------------------


@dataclass(frozen=True)
class Media:
    path: Path
    kind: str  # "image", "gif" or "video"
    width: int  # as displayed: rotation and pixel aspect ratio applied
    height: int
    duration: float  # seconds, 0 when unknown

    @property
    def animated(self) -> bool:
        return self.kind != "image"


def kind_of(path: str | Path) -> str | None:
    ext = Path(path).suffix.lower()
    if ext in IMAGE_EXTS:
        return "image"
    if ext in GIF_EXTS:
        return "gif"
    if ext in VIDEO_EXTS:
        return "video"
    return None


def natural_key(path: str | Path) -> list:
    return [int(t) if t.isdecimal() else t.casefold() for t in re.split(r"(\d+)", str(path))]


def ff_path(path: Path) -> str:
    """A path ffmpeg cannot mistake for an option or a protocol (a:b.png)."""
    text = str(path)
    return f"file:{text}" if text.startswith("-") or ":" in text else text


def scan_dir(directory: Path, recursive: bool, exclude: set[Path]) -> list[Path]:
    found = []
    for root, dirs, files in os.walk(directory):
        dirs[:] = [d for d in dirs if recursive and not d.startswith(".")]
        found += [Path(root, f) for f in files if not f.startswith(".") and kind_of(f)]
    return sorted((p for p in found if p.resolve() not in exclude), key=natural_key)


def resolve_item(item: str, recursive: bool) -> list[Path]:
    path = Path(item).expanduser()
    if path.exists():
        return [path]
    if re.search(r"[*?\[]", item):
        matches = sorted(glob.glob(str(path), recursive=recursive), key=natural_key)
        if not matches:
            raise CollageError(f"nothing matches {item!r}")
        return [Path(m) for m in matches]
    raise CollageError(f"no such file or directory: {item}")


def collect_inputs(args: argparse.Namespace, exclude: set[Path], ui: UI) -> list[Path]:
    paths = []
    for item in args.inputs:
        for path in resolve_item(item, args.recursive):
            if path.is_dir():
                paths += scan_dir(path, args.recursive, exclude)
            elif kind_of(path):
                paths.append(path)
            else:
                ui.warn(f"skipping {path}: not an image, GIF or video")
    if not paths:
        raise CollageError("no usable inputs: nothing is an image, GIF or video")
    return paths


def parse_ratio(text: str) -> float:
    try:
        num, den = (float(part) for part in text.split(":"))
    except ValueError:
        return 1.0
    return num / den if num > 0 and den > 0 else 1.0


def parse_duration(info: dict, stream: dict) -> float:
    for value in (info.get("format", {}).get("duration"), stream.get("duration")):
        try:
            return max(float(value), 0.0)
        except (TypeError, ValueError):
            continue
    return 0.0


def probe(path: Path) -> Media:
    cmd = ["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_streams", "-show_format", "-of", "json", ff_path(path)]
    result = subprocess.run(cmd, capture_output=True, text=True, errors="replace")
    try:
        info = json.loads(result.stdout)
        stream = info["streams"][0]
        width = round(stream["width"] * parse_ratio(stream.get("sample_aspect_ratio", "1:1")))
        height = stream["height"]
        if width < 1 or height < 1:
            raise ValueError("empty picture")
    except (ValueError, KeyError, IndexError):
        lines = result.stderr.strip().splitlines()
        raise CollageError(f"cannot read {path}: {lines[-1] if lines else 'no video stream found'}") from None
    rotation = next((float(d["rotation"]) for d in stream.get("side_data_list", []) if "rotation" in d), 0.0)
    if int(rotation) % 180 == 90:
        width, height = height, width
    return Media(path, kind_of(path), width, height, parse_duration(info, stream))


def load_media(paths: list[Path]) -> list[Media]:
    with ThreadPoolExecutor(max_workers=8) as pool:
        return list(pool.map(probe, paths))


# --------------------------------------------------------------------------
# Layout and settings
# --------------------------------------------------------------------------


@dataclass
class Spec:
    """Everything resolved from the arguments and the inputs."""

    kind: str  # "image", "gif" or "video"
    output: Path
    cols: int
    rows: int
    cell: tuple[int, int]
    gap: int
    bg: str
    fps: int
    quality: int
    shortest: bool
    labels: list[str | None]  # one per input, None = unlabelled
    hold: float  # seconds a still is held in animated output
    seconds: float | None  # length of the result, for progress

    @property
    def canvas(self) -> tuple[int, int]:
        (w, h), gap = self.cell, self.gap
        return self.cols * w + (self.cols - 1) * gap, self.rows * h + (self.rows - 1) * gap

    def origin(self, index: int) -> tuple[int, int]:
        """Top-left corner of cell `index` on the canvas."""
        (w, h), gap = self.cell, self.gap
        return index % self.cols * (w + gap), index // self.cols * (h + gap)


def even(value: float) -> int:
    return max(2, int(value / 2 + 0.5) * 2)


def output_kind(path: Path) -> str:
    ext = path.suffix.lower()
    if ext == ".gif":
        return "gif"
    if ext in VIDEO_OUT:
        return "video"
    if ext in IMAGE_OUT:
        return "image"
    supported = " ".join(sorted({".gif"} | VIDEO_OUT | IMAGE_OUT))
    raise UsageError(f"unsupported output {path.name!r}: the extension must be one of {supported}")


def default_kind(media: list[Media]) -> str:
    if not any(m.animated for m in media):
        return "image"
    return "video" if any(m.kind == "video" for m in media) else "gif"


def grid_shape(count: int, args: argparse.Namespace) -> tuple[int, int]:
    cols, rows = args.cols, args.rows
    if args.horizontal:
        rows = 1
    if args.vertical:
        cols = 1
    if cols and rows:
        if cols * rows < count:
            raise UsageError(f"{count} inputs do not fit a grid of {rows} rows x {cols} columns")
        return cols, rows
    if not cols:
        cols = math.ceil(count / rows) if rows else min(count, 4)
    return cols, math.ceil(count / cols)


def make_labels(args: argparse.Namespace, media: list[Media]) -> list[str | None]:
    if len(args.caption) > len(media):
        raise UsageError(f"{len(args.caption)} captions given for {len(media)} inputs")
    if args.no_labels:
        return [None] * len(media)
    texts = [args.caption[i] if i < len(args.caption) else m.path.stem for i, m in enumerate(media)]
    return [" ".join(unicodedata.normalize("NFC", text).split()) or None for text in texts]


def make_spec(args: argparse.Namespace, media: list[Media], kind: str, output: Path) -> Spec:
    cols, rows = grid_shape(len(media), args)
    if args.cell:
        cell = even(args.cell[0]), even(args.cell[1])
    else:
        height = even(args.height or CELL_HEIGHT[kind])
        cell = even(height * media[0].width / media[0].height), height
    durations = [m.duration for m in media if m.animated and m.duration > 0]
    hold = max(durations, default=STILL_HOLD)
    seconds = None if kind == "image" else (min(durations, default=hold) if args.shortest else hold)
    return Spec(
        kind=kind, output=output, cols=cols, rows=rows, cell=cell, gap=args.gap + args.gap % 2,
        bg=args.bg, fps=args.fps or FPS.get(kind, 0), quality=args.quality, shortest=args.shortest,
        labels=make_labels(args, media), hold=hold, seconds=seconds,
    )


# --------------------------------------------------------------------------
# ffmpeg capabilities
# --------------------------------------------------------------------------


def require_tools() -> None:
    missing = [tool for tool in ("ffmpeg", "ffprobe") if not shutil.which(tool)]
    if missing:
        raise CollageError(f"{' and '.join(missing)} not found: {INSTALL_HINT}")


@functools.cache
def encoders() -> frozenset[str]:
    """Names of the encoders this ffmpeg was built with."""
    listing = subprocess.run(["ffmpeg", "-hide_banner", "-encoders"], capture_output=True, text=True).stdout
    return frozenset(line.split()[1] for line in listing.splitlines() if line.startswith(" ") and len(line.split()) > 1)


@functools.cache
def fps_keeps_last_frame() -> bool:
    """Newer ffmpeg drops a lone frame (a still, a one-frame clip) at low frame rates unless
    fps gets eof_action=pass, and an input without frames silently empties the whole output."""
    listing = subprocess.run(["ffmpeg", "-hide_banner", "-h", "filter=fps"], capture_output=True, text=True).stdout
    return "eof_action" in listing


def check_encoder(spec: Spec) -> None:
    ext = spec.output.suffix.lower()
    if ext == ".webp":
        encoder = "libwebp"
    elif spec.kind == "video":
        encoder = "libvpx-vp9" if ext == ".webm" else "libx264"
    else:
        return
    if encoder not in encoders():
        raise CollageError(f"this ffmpeg has no {encoder} encoder, so it cannot write {ext} files")


# --------------------------------------------------------------------------
# The ffmpeg filter graph
# --------------------------------------------------------------------------


def pixel_format(spec: Spec) -> str:
    return "yuv420p" if spec.kind == "video" else "rgb24"


def cell_filter(index: int, media: Media, spec: Spec) -> str:
    """Scale one input to fit its cell, letterbox it, make it [v<index>]."""
    w, h = spec.cell
    animated_out = spec.kind != "image"
    steps = ["setpts=PTS-STARTPTS", "scale=iw*sar:ih"]
    if animated_out:
        steps.append(f"fps={spec.fps}" + (":eof_action=pass" if fps_keeps_last_frame() else ""))
    steps += [
        f"scale={w}:{h}:force_original_aspect_ratio=decrease:flags=lanczos",
        f"pad={w}:{h}:(ow-iw)/2:(oh-ih)/2:color={spec.bg}",
        "setsar=1",
    ]
    if animated_out and not media.animated:
        steps.append(f"tpad=stop_mode=clone:stop_duration={spec.hold:.3f},trim=duration={spec.hold:.3f}")
    steps.append(f"format={pixel_format(spec)}")
    return f"[{index}:v:0]" + ",".join(steps) + f"[v{index}]"


def stack_filter(spec: Spec, count: int, label: str) -> str:
    pads = "".join(f"[v{i}]" for i in range(count))
    cw, ch = spec.canvas
    if count == 1:
        head = f"{pads}null"
    else:
        layout = "|".join("{}_{}".format(*spec.origin(i)) for i in range(count))
        head = f"{pads}xstack=inputs={count}:layout={layout}:fill={spec.bg}" + (":shortest=1" if spec.shortest else "")
    return f"{head},pad={cw}:{ch}:0:0:color={spec.bg}[{label}]"


def build_graph(spec: Spec, media: list[Media]) -> str:
    """The whole filter graph; with labels the PNG made by render_labels is input number len(media)."""
    cells = [cell_filter(i, m, spec) for i, m in enumerate(media)]
    if not any(spec.labels):
        return ";".join([*cells, stack_filter(spec, len(media), "out")])
    overlay = f"[stacked][{len(media)}:v:0]overlay=0:0:format=auto,format={pixel_format(spec)}[out]"
    return ";".join([*cells, stack_filter(spec, len(media), "stacked"), overlay])


# --------------------------------------------------------------------------
# Labels: one transparent PNG the size of the canvas, drawn with Pillow
# --------------------------------------------------------------------------


def load_font(size: int):
    from PIL import ImageFont

    for path in FONTS:
        try:
            return ImageFont.truetype(path, size)
        except OSError:
            continue
    return ImageFont.load_default(size)


def label_tile(text: str, cell: tuple[int, int], font, pad: int):
    """One cell-sized transparent tile: white text on a translucent black box at the top-left.
    Being cell-sized, it clips a label that is wider than its cell."""
    from PIL import Image, ImageDraw

    tile = Image.new("RGBA", cell, (0, 0, 0, 0))
    left, top, right, bottom = ImageDraw.Draw(tile).textbbox((0, 0), text, font=font)
    margin = 2
    box = (margin, margin, margin + right - left + 2 * pad - 1, margin + bottom - top + 2 * pad - 1)
    ImageDraw.Draw(tile).rectangle(box, fill=(0, 0, 0, 153))
    mask = Image.new("L", cell, 0)
    ImageDraw.Draw(mask).text((margin + pad - left, margin + pad - top), text, font=font, fill=255)
    ink = Image.new("RGBA", cell, (255, 255, 255, 255))
    ink.putalpha(mask)
    return Image.alpha_composite(tile, ink)


def render_labels(spec: Spec, path: Path) -> None:
    try:
        from PIL import Image
    except ImportError:
        raise CollageError("labels need the 'pillow' package: start collage through 'uv run', or pass --no-labels") from None
    size = max(10, round(spec.cell[1] / 16))
    font = load_font(size)
    canvas = Image.new("RGBA", spec.canvas, (0, 0, 0, 0))
    for index, text in enumerate(spec.labels):
        if text:
            canvas.paste(label_tile(text, spec.cell, font, max(2, size // 4)), spec.origin(index))
    canvas.save(path)


# --------------------------------------------------------------------------
# Plan: the commands that produce the output
# --------------------------------------------------------------------------


@dataclass
class Job:
    cmd: list[str]
    label: str
    seconds: float | None = None  # ffmpeg jobs with a known length report progress
    frames_dir: Path | None = None  # gifski: the PNG frames found here are appended to cmd


@dataclass
class Plan:
    jobs: list[Job]
    labels_png: Path | None  # the label overlay collage renders itself, if any label is shown


def ffmpeg_cmd(inputs: list[str], graph: str, *tail: str) -> list[str]:
    head = ["ffmpeg", "-hide_banner", "-nostdin", "-loglevel", "warning", "-y"]
    return [*head, *inputs, "-filter_complex", graph, *tail]


def image_jobs(spec: Spec, inputs: list[str], graph: str, work: Path, out: Path) -> list[Job]:
    quality = ["-q:v", "2"] if spec.output.suffix.lower() in (".jpg", ".jpeg") else []
    return [Job(ffmpeg_cmd(inputs, graph, "-map", "[out]", "-frames:v", "1", "-update", "1", *quality, str(out)), "rendering image")]


def video_jobs(spec: Spec, inputs: list[str], graph: str, work: Path, out: Path) -> list[Job]:
    ext = spec.output.suffix.lower()
    codec = ["-c:v", "libvpx-vp9", "-crf", "32", "-b:v", "0"] if ext == ".webm" else ["-c:v", "libx264", "-preset", "medium", "-crf", "23"]
    faststart = ["-movflags", "+faststart"] if ext in (".mp4", ".mov") else []
    cmd = ffmpeg_cmd(inputs, graph, "-map", "[out]", "-an", *codec, "-pix_fmt", "yuv420p", *faststart, str(out))
    return [Job(cmd, "encoding video", spec.seconds)]


def gif_jobs(spec: Spec, inputs: list[str], graph: str, work: Path, out: Path) -> list[Job]:
    if shutil.which("gifski"):
        return gifski_jobs(spec, inputs, graph, work, out)
    return palette_jobs(spec, inputs, graph, work, out)


def gifski_jobs(spec: Spec, inputs: list[str], graph: str, work: Path, out: Path) -> list[Job]:
    frames = ffmpeg_cmd(inputs, graph, "-map", "[out]", "-c:v", "png", "-compression_level", "1", str(work / "frame_%05d.png"))
    width, height = spec.canvas  # explicit size: gifski would otherwise shrink big canvases
    encode = [
        "gifski", "--quiet", "--fps", str(spec.fps), "--quality", str(spec.quality),
        "--width", str(width), "--height", str(height), "-o", str(out),
    ]
    return [Job(frames, "rendering frames", spec.seconds), Job(encode, "encoding GIF with gifski", frames_dir=work)]


def palette_jobs(spec: Spec, inputs: list[str], graph: str, work: Path, out: Path) -> list[Job]:
    """GIF without gifski: ffmpeg palettegen/paletteuse in two passes (constant memory)."""
    colors = 32 + round(224 * (spec.quality - 1) / 99)
    dither = "sierra2_4a" if spec.quality >= 50 else "bayer:bayer_scale=5"
    palette = work / "palette.png"
    first = ffmpeg_cmd(inputs, f"{graph};[out]palettegen=max_colors={colors}[pal]", "-map", "[pal]", "-frames:v", "1", "-update", "1", str(palette))
    use = f"{graph};[out][{len(inputs) // 2}:v]paletteuse=dither={dither}:diff_mode=rectangle[gif]"
    second = ffmpeg_cmd([*inputs, "-i", str(palette)], use, "-map", "[gif]", str(out))
    return [Job(first, "building palette (pass 1/2)"), Job(second, "encoding GIF (pass 2/2)", spec.seconds)]


def build_plan(spec: Spec, media: list[Media], work: Path, out: Path) -> Plan:
    labels_png = work / "labels.png" if any(spec.labels) else None
    inputs = [arg for m in media for arg in ("-i", ff_path(m.path))]
    if labels_png:
        inputs += ["-i", ff_path(labels_png)]
    make_jobs = {"image": image_jobs, "video": video_jobs, "gif": gif_jobs}[spec.kind]
    return Plan(make_jobs(spec, inputs, build_graph(spec, media), work, out), labels_png)


# --------------------------------------------------------------------------
# Running
# --------------------------------------------------------------------------

PROGRESS_LINE = re.compile(r"(frame|fps|stream_\d+_\d+_q|bitrate|total_size|out_time_us|out_time_ms|out_time|dup_frames|drop_frames|speed|progress)=(.*)")


def raise_fd_limit() -> None:
    """ffmpeg keeps every input open; macOS allows only 256 files per process by default."""
    soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
    wanted = 4096 if hard == resource.RLIM_INFINITY else min(hard, 4096)
    if soft < wanted:
        try:
            resource.setrlimit(resource.RLIMIT_NOFILE, (wanted, hard))
        except (ValueError, OSError):
            pass


def stop_when_cancelled(proc: subprocess.Popen, ui: UI) -> None:
    while proc.poll() is None:
        if ui.cancelled:
            proc.kill()
        time.sleep(0.2)


def run_job(job: Job, ui: UI) -> None:
    cmd = list(job.cmd)
    if job.frames_dir:
        cmd += sorted(str(p) for p in job.frames_dir.glob("frame_*.png"))
        if len(cmd) == len(job.cmd):
            raise CollageError("ffmpeg wrote no frames")
    if job.seconds is not None:
        cmd[1:1] = ["-progress", "pipe:1", "-nostats"]
    ui.progress(job.label, 0.0)
    log: list[str] = []
    try:
        proc = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace")
    except OSError as error:
        raise CollageError(f"cannot run {cmd[0]}: {error.strerror}") from None
    threading.Thread(target=stop_when_cancelled, args=(proc, ui), daemon=True).start()
    try:
        for line in proc.stdout:
            match = PROGRESS_LINE.fullmatch(line.strip())
            if not match:
                log.append(line.rstrip())
            elif match[1] in ("out_time_us", "out_time_ms") and job.seconds:
                done = max(int(match[2]) / 1e6, 0.0) if match[2].lstrip("-").isdigit() else 0.0
                ui.progress(job.label, min(done / job.seconds, 1.0))
        code = proc.wait()
    finally:
        if proc.poll() is None:  # Ctrl-C
            proc.kill()
        proc.wait()
    if ui.cancelled:
        raise CollageError("cancelled")
    if code != 0:
        detail = "\n".join(log[-30:]) or "(no output)"
        raise CollageError(f"{cmd[0]} failed with exit code {code}:\n{detail}")
    if job.seconds:
        ui.progress(job.label, 1.0)


def render(spec: Spec, media: list[Media], ui: UI) -> None:
    """Build the output in a scratch directory next to it, then rename it into place."""
    try:
        work = Path(tempfile.mkdtemp(prefix=".collage-", dir=spec.output.parent)).resolve()
    except OSError as error:
        raise CollageError(f"cannot write to {spec.output.parent}: {error.strerror}") from None
    try:
        out = work / f"out{spec.output.suffix}"
        plan = build_plan(spec, media, work, out)
        if plan.labels_png:
            render_labels(spec, plan.labels_png)
        for job in plan.jobs:
            run_job(job, ui)
        if not out.is_file() or out.stat().st_size == 0:
            raise CollageError("ffmpeg finished but wrote no output")
        os.replace(out, spec.output)
    finally:
        shutil.rmtree(work, ignore_errors=True)


def print_dry_run(plan: Plan, spec: Spec, work: Path) -> None:
    """The commands of a real run as a shell script."""
    print(f"mkdir -p {shlex.quote(str(work))}")
    if plan.labels_png:
        width, height = spec.canvas
        print(f"# {plan.labels_png} is not written by a dry run: collage renders it itself with Pillow")
        print(f"# (a transparent {width}x{height} PNG with one label box per cell) and ffmpeg overlays it once")
    for job in plan.jobs:
        line = shlex.join(job.cmd)
        if job.frames_dir:
            line += f" {shlex.quote(str(job.frames_dir) + '/')}frame_*.png"
        print(line)
    print(f"rm -rf {shlex.quote(str(work))}")


def human_size(size: float) -> str:
    for unit in ("B", "KB", "MB"):
        if size < 1024:
            return f"{size:.0f} {unit}" if unit == "B" else f"{size:.1f} {unit}"
        size /= 1024
    return f"{size:.1f} GB"


def check_overwrite(output: Path, force: bool, ui: UI) -> None:
    if output.is_dir():
        raise CollageError(f"{output} is a directory")
    if output.exists() and not force and not ui.confirm(f"{output} exists. Overwrite?"):
        raise CollageError(f"{output} already exists (use -y/--force to overwrite)")


def run(args: argparse.Namespace, ui: UI) -> None:
    """The whole job; shared by the command line and the TUI."""
    if not args.inputs:
        raise UsageError("no input files given (run 'collage' without arguments for the TUI)")
    require_tools()
    raise_fd_limit()
    output = Path(args.output).expanduser() if args.output else None
    kind = output_kind(output) if output else None
    names = [output] if output else [Path(f"collage{ext}") for ext in (".png", ".mp4", ".gif")]
    media = load_media(collect_inputs(args, {p.resolve() for p in names}, ui))
    kind = kind or default_kind(media)
    output = output or Path({"image": "collage.png", "video": "collage.mp4", "gif": "collage.gif"}[kind])
    spec = make_spec(args, media, kind, output)
    check_encoder(spec)
    summary = f"{len(media)} input{'' if len(media) == 1 else 's'}, grid {spec.rows}x{spec.cols} (rows x cols), cell {spec.cell[0]}x{spec.cell[1]}, output {spec.canvas[0]}x{spec.canvas[1]}"
    ui.info(f"# {summary}" if args.dry_run else summary)
    if args.dry_run:
        work = output.parent / ".collage-work"
        print_dry_run(build_plan(spec, media, work, output), spec, work)
        return
    check_overwrite(output, args.force, ui)
    render(spec, media, ui)
    ui.info(f"wrote {output} ({human_size(output.stat().st_size)})")


# --------------------------------------------------------------------------
# TUI (textual is imported only here)
# --------------------------------------------------------------------------


def make_app(initial_inputs: str = ""):
    from rich.text import Text
    from textual import on, work
    from textual.app import App, ComposeResult
    from textual.binding import Binding
    from textual.containers import Horizontal, Vertical
    from textual.screen import ModalScreen
    from textual.widgets import Button, Checkbox, Footer, Header, Input, Label, RichLog, Static

    class ConfirmScreen(ModalScreen[bool]):
        BINDINGS = [("y", "answer(True)", "Yes"), ("n", "answer(False)", "No"), ("escape", "answer(False)", "No")]
        DEFAULT_CSS = """
        ConfirmScreen { align: center middle; }
        #dialog { width: 60; height: auto; padding: 1 2; border: tall $accent; background: $surface; }
        #dialog-buttons { height: auto; margin-top: 1; }
        #dialog-buttons Button { width: 1fr; margin-right: 1; }
        """

        def __init__(self, question: str) -> None:
            super().__init__()
            self.question = question

        def compose(self) -> ComposeResult:
            with Vertical(id="dialog"):
                yield Static(Text(self.question))
                with Horizontal(id="dialog-buttons"):
                    yield Button("Overwrite (y)", id="yes", variant="warning")
                    yield Button("Cancel (n)", id="no")

        def action_answer(self, value: bool) -> None:
            self.dismiss(value)

        @on(Button.Pressed)
        def _pressed(self, event: Button.Pressed) -> None:
            self.dismiss(event.button.id == "yes")

    class LogUI(UI):
        """Streams the engine's reports into the RichLog (called from the worker thread)."""

        def __init__(self, app: CollageApp) -> None:
            self.app = app
            self._last_step: dict[str, int] = {}

        @property
        def cancelled(self) -> bool:
            return self.app.quitting

        def line(self, message: str, style: str = "") -> None:
            try:
                self.app.call_from_thread(self.app.write_log, Text(message, style=style))
            except RuntimeError:  # the app is already gone
                pass

        def info(self, message: str) -> None:
            self.line(message)

        def warn(self, message: str) -> None:
            self.line(f"warning: {message}", "yellow")

        def progress(self, label: str, fraction: float) -> None:
            step = int(fraction * 10)
            if self._last_step.get(label) != step:
                self._last_step[label] = step
                self.line(f"{label} {step * 10}%" if step else f"{label}...", "dim")

        def confirm(self, question: str) -> bool:
            answer: list[bool] = []
            answered = threading.Event()

            def done(value: bool | None) -> None:
                answer.append(bool(value))
                answered.set()

            self.app.call_from_thread(self.app.push_screen, ConfirmScreen(question), done)
            while not answered.wait(0.2):
                if self.cancelled:
                    return False
            return answer[0]

    class CollageApp(App):
        TITLE = "collage"
        SUB_TITLE = "images, GIFs and videos in a grid or a stack"

        theme = "nord"

        BINDINGS = [
            Binding("ctrl+r", "run_collage", "Run"),
            Binding("ctrl+l", "clear_log", "Clear log"),
            Binding("ctrl+q", "quit", "Quit"),
            Binding("escape", "quit", "Quit", show=False),
        ]

        CSS = """
        Screen { layout: vertical; }

        #form { padding: 1 2; height: auto; }

        .section-title { text-style: bold; color: $accent; height: 1; margin: 1 0 0 0; }

        .field-row { height: 1; margin: 0 0 1 0; }

        .field-label { width: 12; height: 1; padding: 0; text-style: bold; color: $text-muted; }

        Input { border: none; height: 1; padding: 0 1; width: 1fr; }

        #options-row { height: 1; margin: 0 0 1 0; }
        #options-row .field-label { width: 11; }
        #options-row Input { width: 10; margin-right: 1; }

        Checkbox { border: none; height: 1; margin: 0; padding: 0; background: transparent; }
        #toggles-row { height: 1; margin: 0 0 1 0; }
        #toggles-row Checkbox { margin-right: 3; }

        #command-preview { margin: 1 0 0 0; padding: 0 1; background: $surface; height: auto; color: $text-muted; }

        #btn-row { height: auto; margin: 1 2; }
        .action-btn { width: 1fr; min-width: 10; height: 1; border: none; margin: 0 1 0 0; }

        #log { margin: 0 2 1 2; height: 1fr; border: tall $accent; }
        """

        def __init__(self) -> None:
            super().__init__()
            self.quitting = False
            self.running = False
            self.command_line = ""  # the command shown in the preview

        def compose(self) -> ComposeResult:
            yield Header()
            with Vertical(id="form"):
                yield Static("── Input ──", classes="section-title")
                with Horizontal(classes="field-row"):
                    yield Label("Files:", classes="field-label")
                    yield Input(value=initial_inputs, placeholder="files, globs or folders  e.g.  ~/clips/*.gif  or  photos/", id="inputs")

                yield Static("── Options ──", classes="section-title")
                with Horizontal(id="options-row"):
                    yield Label("Columns:", classes="field-label")
                    yield Input(placeholder="auto", id="cols")
                    yield Label("Height px:", classes="field-label")
                    yield Input(placeholder="auto", id="height")
                    yield Label("FPS:", classes="field-label")
                    yield Input(placeholder="auto", id="fps")
                with Horizontal(classes="field-row"):
                    yield Label("Output:", classes="field-label")
                    yield Input(placeholder="auto: collage.png / .gif / .mp4 by input type", id="output")
                with Horizontal(id="toggles-row"):
                    yield Checkbox("Labels", value=True, id="labels")
                    yield Checkbox("Recursive", value=False, id="recursive")

                yield Static("", id="command-preview")

            with Horizontal(id="btn-row"):
                yield Button("▶  Run", id="run-btn", variant="primary", classes="action-btn")
                yield Button("Clear Log", id="clear-btn", variant="default", classes="action-btn")

            yield RichLog(id="log", wrap=True)
            yield Footer()

        def on_mount(self) -> None:
            self.refresh_preview()

        def field(self, field_id: str) -> str:
            return self.query_one(f"#{field_id}", Input).value.strip()

        def form_argv(self) -> list[str]:
            """The command line (after `collage`) that the form stands for."""
            argv = shlex.split(self.field("inputs"))
            for flag, field_id in (("--cols", "cols"), ("--height", "height"), ("--fps", "fps"), ("-o", "output")):
                if self.field(field_id):
                    argv += [flag, self.field(field_id)]
            if not self.query_one("#labels", Checkbox).value:
                argv.append("--no-labels")
            if self.query_one("#recursive", Checkbox).value:
                argv.append("--recursive")
            return argv

        @on(Input.Changed)
        @on(Checkbox.Changed)
        def refresh_preview(self) -> None:
            preview = self.query_one("#command-preview", Static)
            try:
                argv = self.form_argv()
                parse_args(argv)  # the same check the CLI applies
            except (ValueError, UsageError) as error:
                self.command_line = ""
                preview.update(Text(f"✗ {error}", style="red"))
                return
            if not self.field("inputs"):
                self.command_line = ""
                preview.update(Text("add files, globs or a folder to see the command", style="italic dim"))
                return
            self.command_line = shlex.join(["collage", *argv])
            preview.update(Text.assemble(("$ ", "bold"), self.command_line))

        def write_log(self, message: Text) -> None:
            self.query_one("#log", RichLog).write(message)

        def action_clear_log(self) -> None:
            self.query_one("#log", RichLog).clear()

        def action_quit(self) -> None:
            self.quitting = True  # lets a running job stop its ffmpeg
            self.exit()

        @on(Button.Pressed, "#clear-btn")
        def _clear_pressed(self) -> None:
            self.action_clear_log()

        @on(Button.Pressed, "#run-btn")
        def _run_pressed(self) -> None:
            self.action_run_collage()

        def action_run_collage(self) -> None:
            if self.running:
                return
            try:
                args = parse_args(self.form_argv())
            except (ValueError, UsageError) as error:
                self.write_log(Text(f"error: {error}", style="bold red"))
                return
            self.running = True
            self.query_one("#run-btn", Button).disabled = True
            self.write_log(Text.assemble(("▶ ", "bold green"), self.command_line))
            self.run_in_thread(args)

        @work(thread=True)
        def run_in_thread(self, args) -> None:
            ui = LogUI(self)
            try:
                run(args, ui)
                ui.line("✓ done", "bold green")
            except (UsageError, CollageError) as error:
                ui.line(f"✗ {error}", "bold red")
            except Exception as error:  # a bug: keep the TUI alive and say so
                ui.line(f"✗ unexpected error: {error!r}", "bold red")
            finally:
                self.call_from_thread(self.finish_run)

        def finish_run(self) -> None:
            self.running = False
            self.query_one("#run-btn", Button).disabled = False

    return CollageApp()


def run_tui(initial_inputs: str = "") -> int:
    try:
        app = make_app(initial_inputs)
    except ImportError as error:
        raise CollageError(f"the TUI needs the 'textual' package ({error}); start collage through 'uv run' or install textual") from None
    app.run()
    return 0


# --------------------------------------------------------------------------
# Entry point
# --------------------------------------------------------------------------


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    try:
        if not argv and sys.stdin.isatty():
            return run_tui()
        args = parse_args(argv)
        if args.tui:
            return run_tui(shlex.join(args.inputs))
        run(args, ConsoleUI())
        return 0
    except UsageError as error:
        print(build_parser().format_usage().rstrip(), file=sys.stderr)
        print(f"collage: error: {error}", file=sys.stderr)
        return 2
    except CollageError as error:
        print(f"collage: error: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\ncollage: interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
