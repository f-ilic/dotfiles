#!/bin/bash -x
set -e

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
  cat <<'EOF'
specs-push-lens-spk — Push and install a .spk package on a device via adb

Usage:
  specs-push-lens-spk <package.spk> [name] [--pkg-id <id>]

Arguments:
  package.spk    Path to the .spk file to install.
  name           Package name to install under (defaults to filename without .spk).
  --pkg-id <id>  Override the pkg_id inside the SPK manifest before installing.
                 Use this to install a debug and release build side by side when
                 they share the same pkg_id.

Environment:
  APP   ADB serial of the target device. Auto-detected if not set.

Examples:
  specs-push-lens-spk ./Activity.spk
  specs-push-lens-spk ./UserActivity-debug.spk debug --pkg-id com.example.useracitvity.debug
EOF
  exit 0
fi

if [ -z "$1" ]; then
  echo "Usage: $0 spk-file [name] [--pkg-id <id>]"
  exit 1
fi

SPK_PATH="$1"
SPK_BASENAME="${SPK_PATH##*/}"
SPK_NAME="${SPK_BASENAME%.spk}"

NAME="${2:-$SPK_NAME}"
PKG_ID=""

# Parse --pkg-id
shift; shift 2>/dev/null || true
while [[ $# -gt 0 ]]; do
  case "$1" in
    --pkg-id) PKG_ID="$2"; shift 2 ;;
    *) shift ;;
  esac
done

if [ ! -f "$SPK_PATH" ]; then
  echo "Error: File $SPK_PATH not found"
  exit 1
fi

# Patch pkg_id inside the SPK if requested
PATCHED_SPK=""
if [ -n "$PKG_ID" ]; then
  TMPDIR=$(mktemp -d)
  PATCHED_SPK=$(mktemp).spk
  unzip -q "$SPK_PATH" -d "$TMPDIR"
  python3 - "$TMPDIR/manifest.json" "$PKG_ID" <<'PYEOF'
import json, sys
path, new_id = sys.argv[1], sys.argv[2]
with open(path) as f:
    m = json.load(f)
old_id = m.get("pkg_id", "")
m["pkg_id"] = new_id
with open(path, "w") as f:
    json.dump(m, f, indent=4)
print(f"Patched pkg_id: {old_id} -> {new_id}", flush=True)
PYEOF
  (cd "$TMPDIR" && zip -0 -q "$PATCHED_SPK" manifest.json pkg.zip signedPackage.json)
  rm -rf "$TMPDIR"
  SPK_PATH="$PATCHED_SPK"
  SPK_BASENAME="${SPK_NAME}-patched.spk"
fi

# Detect device
if [ -z "$APP" ]; then
  APP=$(adb devices | tail -n +2 | grep -v '^$' | head -n 1 | cut -f 1)
  if [ -z "$APP" ]; then
    echo "Error: No device found"
    [ -n "$PATCHED_SPK" ] && rm -f "$PATCHED_SPK"
    exit 1
  fi
  echo "Auto-detected device: $APP"
else
  echo "Using device: $APP"
fi

adb -s $APP push "$SPK_PATH" /data/local/$SPK_BASENAME
adb -s $APP shell pkg install --packageFormat SPK --filePath /data/local/$SPK_BASENAME --name "$NAME"

[ -n "$PATCHED_SPK" ] && rm -f "$PATCHED_SPK"
