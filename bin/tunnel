#!/usr/bin/env bash
# tunnel — manage persistent SSH port forwards, per host
#
# Usage:
#   tunnel start        start all tunnels
#   tunnel stop         kill all tunnels
#   tunnel status       show per-host port status
#   tunnel restart      stop then start
#   tunnel edit         interactive port/host editor (TUI)
#   tunnel logs         tail the connection log
#
# Config (~/.tunnel.conf) — INI-style, one [host] section per machine:
#   [beast]
#   port=6006:TensorBoard
#   port=8501:Activity WebUI
#
#   [gpu-2]
#   port=9000:Ray dashboard
#

CONFIG_FILE="$HOME/.tunnel.conf"
LOGFILE="$HOME/.local/share/tunnel/tunnel.log"
PIDFILE="$HOME/.local/share/tunnel/tunnel.pid"

mkdir -p "$(dirname "$LOGFILE")"

# ── config helpers ───────────────────────────────────────────────────────────

# Migrate a legacy single-host config (host=… + flat port=…) to the sectioned
# format, in place. No-op for already-sectioned or missing configs.
_migrate_config() {
    [[ -f "$CONFIG_FILE" ]] || return
    grep -q '^[[:space:]]*host=' "$CONFIG_FILE" || return

    local oldhost="" line
    local portlines=()
    while IFS= read -r line || [[ -n "$line" ]]; do
        case "$line" in
            host=*) oldhost="${line#host=}" ;;
            port=*) portlines+=("$line") ;;
        esac
    done < "$CONFIG_FILE"

    [[ -n "$oldhost" ]] || return

    local tmp
    tmp=$(mktemp) || return
    {
        echo "[$oldhost]"
        local pl
        for pl in "${portlines[@]}"; do
            echo "$pl"
        done
    } > "$tmp"
    mv "$tmp" "$CONFIG_FILE"
    echo "tunnel: migrated ~/.tunnel.conf to per-host format ([$oldhost])" >&2
}

# echo the argument with leading/trailing whitespace stripped
_trim() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    printf '%s' "$s"
}

# Populate HOSTS / PORTS / DESCS (parallel arrays, file order) and UNIQ_HOSTS.
_read_config() {
    HOSTS=()
    PORTS=()
    DESCS=()
    UNIQ_HOSTS=()
    [[ -f "$CONFIG_FILE" ]] || return

    local line current_host=""
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="$(_trim "$line")"
        case "$line" in
            ''|'#'*) continue ;;
        esac
        if [[ "$line" == '['*']' ]]; then
            current_host="${line#\[}"
            current_host="${current_host%\]}"
            current_host="$(_trim "$current_host")"
        elif [[ "$line" == port=* ]]; then
            if [[ -z "$current_host" ]]; then
                echo "tunnel: warning: port before any [host] section, skipping: $line" >&2
                continue
            fi
            local val num desc
            val="${line#port=}"
            num="${val%%:*}"
            desc="${val#*:}"
            [[ "$num" == "$desc" ]] && desc=""   # no colon found
            HOSTS+=("$current_host")
            PORTS+=("$num")
            DESCS+=("$desc")
        fi
    done < "$CONFIG_FILE"

    # derive unique hosts, first-seen order
    local h s found
    for h in "${HOSTS[@]}"; do
        found=0
        for s in "${UNIQ_HOSTS[@]}"; do
            [[ "$s" == "$h" ]] && { found=1; break; }
        done
        [[ $found -eq 0 ]] && UNIQ_HOSTS+=("$h")
    done
}

# echo the -L forward args for one host's ports
_port_args_for() {
    local host="$1" i
    local args=()
    for i in "${!PORTS[@]}"; do
        [[ "${HOSTS[$i]}" == "$host" ]] || continue
        args+=(-L "${PORTS[$i]}:localhost:${PORTS[$i]}")
    done
    echo "${args[@]}"
}

# echo the space-separated port numbers for one host
_ports_for() {
    local host="$1" i
    local list=()
    for i in "${!PORTS[@]}"; do
        [[ "${HOSTS[$i]}" == "$host" ]] && list+=("${PORTS[$i]}")
    done
    echo "${list[*]}"
}

# Populate PF_PIDS / PF_HOSTS from the pidfile.
_read_pidfile() {
    PF_PIDS=()
    PF_HOSTS=()
    [[ -f "$PIDFILE" ]] || return
    local pid host
    while IFS=$'\t' read -r pid host || [[ -n "$pid" ]]; do
        [[ -n "$pid" ]] || continue
        PF_PIDS+=("$pid")
        PF_HOSTS+=("$host")
    done < "$PIDFILE"
}

# echo the pid recorded for a host (empty if none)
_pid_for() {
    local target="$1" i
    for i in "${!PF_HOSTS[@]}"; do
        [[ "${PF_HOSTS[$i]}" == "$target" ]] && { echo "${PF_PIDS[$i]}"; return; }
    done
}

_any_running() {
    _read_pidfile
    local i
    for i in "${!PF_PIDS[@]}"; do
        kill -0 "${PF_PIDS[$i]}" 2>/dev/null && return 0
    done
    return 1
}

# ── commands ─────────────────────────────────────────────────────────────────

cmd_start() {
    _read_config
    if [[ ${#PORTS[@]} -eq 0 ]]; then
        echo "tunnel: no ports configured — run: tunnel edit"
        return 1
    fi
    if _any_running; then
        echo "tunnel: already running — use: tunnel restart"
        return 1
    fi

    : > "$PIDFILE"
    local host rc=0
    for host in "${UNIQ_HOSTS[@]}"; do
        local port_args
        read -ra port_args <<< "$(_port_args_for "$host")"

        echo "[$(date '+%F %T')] starting tunnels to $host: ports $(_ports_for "$host")" >> "$LOGFILE"

        AUTOSSH_LOGFILE="$LOGFILE" \
        AUTOSSH_POLL=30 \
        AUTOSSH_GATETIME=0 \
        autossh -M 0 -f -N \
            -o "ServerAliveInterval=15" \
            -o "ServerAliveCountMax=3" \
            -o "ExitOnForwardFailure=yes" \
            -o "ConnectTimeout=10" \
            "${port_args[@]}" \
            "$host"

        sleep 0.5
        local pid
        pid=$(pgrep -n -f "autossh.*[[:space:]]${host}([[:space:]]|\$)" 2>/dev/null)
        if [[ -n "$pid" ]]; then
            printf '%s\t%s\n' "$pid" "$host" >> "$PIDFILE"
            echo "tunnel: $host started (pid $pid) — ports: $(_ports_for "$host")"
        else
            echo "tunnel: $host failed to start — check: tunnel logs"
            rc=1
        fi
    done
    return $rc
}

cmd_stop() {
    _read_config
    _read_pidfile

    local i
    for i in "${!PF_PIDS[@]}"; do
        local pid="${PF_PIDS[$i]}" host="${PF_HOSTS[$i]}"
        if kill "$pid" 2>/dev/null; then
            echo "tunnel: stopped $host (pid $pid)"
        else
            echo "tunnel: $host (pid $pid) was not running"
        fi
    done
    rm -f "$PIDFILE"

    # fallback: sweep any strays for each configured host
    local host
    for host in "${UNIQ_HOSTS[@]}"; do
        pkill -f "autossh.*[[:space:]]${host}([[:space:]]|\$)" 2>/dev/null
        pkill -f "ssh.*-N.*[[:space:]]${host}([[:space:]]|\$)" 2>/dev/null
    done
    echo "[$(date '+%F %T')] tunnels stopped" >> "$LOGFILE"
}

cmd_status() {
    _read_config
    _read_pidfile
    if [[ ${#PORTS[@]} -eq 0 ]]; then
        echo "tunnel: no ports configured — run: tunnel edit"
        return
    fi

    local host
    for host in "${UNIQ_HOSTS[@]}"; do
        local pid state
        pid="$(_pid_for "$host")"
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            state="RUNNING (pid $pid)"
        else
            state="STOPPED"
        fi
        echo ""
        echo "$host — $state"
        printf "  %-7s %-10s %s\n" "PORT" "REACHABLE" "DESCRIPTION"
        echo "  ─────────────────────────────────────"
        local i
        for i in "${!PORTS[@]}"; do
            [[ "${HOSTS[$i]}" == "$host" ]] || continue
            local port="${PORTS[$i]}" desc="${DESCS[$i]}" reach
            if nc -z -w1 localhost "$port" 2>/dev/null; then
                reach="yes"
            else
                reach="no"
            fi
            printf "  %-7s %-10s %s\n" "$port" "$reach" "$desc"
        done
    done
}

cmd_restart() {
    cmd_stop
    sleep 1
    cmd_start
}

cmd_logs() {
    if [[ ! -f "$LOGFILE" ]]; then
        echo "tunnel: no log file yet"
        return
    fi
    tail -f "$LOGFILE"
}

cmd_edit() {
    local tmp
    tmp=$(mktemp /tmp/tunnel-edit-XXXXXX.py)
    cat > "$tmp" << 'PYTHON'
#!/usr/bin/env python3
import curses, sys, os, re

CONFIG = sys.argv[1]

def load():
    entries = []          # [num, host, desc]
    current = None
    if os.path.exists(CONFIG):
        for line in open(CONFIG):
            s = line.strip()
            if not s or s.startswith("#"):
                continue
            if s.startswith("[") and s.endswith("]"):
                current = s[1:-1].strip()
            elif s.startswith("port="):
                if not current:
                    continue          # orphan port, no host
                num, _, desc = s[5:].partition(":")
                entries.append([num.strip(), current, desc.strip()])
    return entries

def save(entries):
    order, groups = [], {}
    for num, host, desc in entries:
        if not host:
            continue
        if host not in groups:
            groups[host] = []
            order.append(host)
        groups[host].append((num, desc))
    with open(CONFIG, "w") as f:
        for i, host in enumerate(order):
            if i:
                f.write("\n")
            f.write(f"[{host}]\n")
            for num, desc in groups[host]:
                f.write(f"port={num}:{desc}\n")

def valid_port(s):
    return bool(re.fullmatch(r'\d+', s)) and 1 <= int(s) <= 65535

def read_line(stdscr, prompt, default=""):
    h, w = stdscr.getmaxyx()
    curses.curs_set(1)
    buf = list(default)
    while True:
        stdscr.move(h - 2, 0)
        stdscr.clrtoeol()
        line = f"  {prompt}: {''.join(buf)}"
        stdscr.addstr(h - 2, 0, line[:w - 1])
        stdscr.refresh()
        ch = stdscr.getch()
        if ch in (10, 13):
            curses.curs_set(0)
            return "".join(buf)
        elif ch == 27:
            curses.curs_set(0)
            return None
        elif ch in (curses.KEY_BACKSPACE, 127, 8):
            if buf:
                buf.pop()
        elif 32 <= ch < 127:
            buf.append(chr(ch))

def prompt_entry(stdscr, num0, host0, desc0):
    # → [num, host, desc] on success, str error message, or None if cancelled
    num = read_line(stdscr, "port number", num0)
    if num is None:
        return None
    num = num.strip()
    if not valid_port(num):
        return "invalid port number"
    host = read_line(stdscr, "host", host0)
    if host is None:
        return None
    host = host.strip()
    if not host:
        return "host required"
    desc = read_line(stdscr, "description", desc0)
    if desc is None:
        return None
    return [num, host, desc.strip()]

def draw(stdscr, entries, sel, msg):
    stdscr.clear()
    h, w = stdscr.getmaxyx()
    numw = min(8, max([4] + [len(e[0]) for e in entries]))
    hostw = min(20, max([4] + [len(e[1]) for e in entries]))

    try:
        stdscr.addstr(0, 0, " tunnel config", curses.A_BOLD)
        header = f"  {'PORT':<{numw}}  {'HOST':<{hostw}}  DESCRIPTION"
        stdscr.addstr(2, 0, header[:w - 1])
        stdscr.addstr(3, 0, "  " + "─" * min(len(header), w - 3))

        for i, (num, host, desc) in enumerate(entries):
            row = 4 + i
            if row >= h - 3:
                break
            attr = curses.A_REVERSE if i == sel else curses.A_NORMAL
            line = f"  {num:<{numw}}  {host:<{hostw}}  {desc}"
            padded = line[:w - 1].ljust(min(w - 1, max(len(line), 20)))
            stdscr.addstr(row, 0, padded, attr)

        if not entries:
            stdscr.addstr(4, 0, "  (no ports — press a to add)", curses.A_DIM)

        footer = "  a add   d del   e/⏎ edit   q save   Q quit"
        stdscr.addstr(h - 3, 0, "─" * (w - 1), curses.A_DIM)
        stdscr.addstr(h - 2, 0, footer[:w - 1])
        if msg:
            stdscr.addstr(h - 1, 0, f"  {msg}"[:w - 1], curses.A_DIM)
    except curses.error:
        pass

    stdscr.refresh()

def main(stdscr):
    curses.curs_set(0)
    stdscr.keypad(True)
    entries = load()
    sel = 0
    msg = ""

    while True:
        if entries:
            sel = max(0, min(sel, len(entries) - 1))

        draw(stdscr, entries, sel, msg)
        msg = ""
        ch = stdscr.getch()

        if ch == ord('q'):
            save(entries)
            break
        elif ch in (ord('Q'), 27):
            break
        elif ch in (ord('j'), curses.KEY_DOWN):
            sel += 1
        elif ch in (ord('k'), curses.KEY_UP):
            sel -= 1
        elif ch in (ord('e'), 10, 13) and entries:
            num, host, desc = entries[sel]
            res = prompt_entry(stdscr, num, host, desc)
            if isinstance(res, list):
                entries[sel] = res
            elif isinstance(res, str):
                msg = res
        elif ch == ord('a'):
            default_host = entries[sel][1] if entries else ""
            res = prompt_entry(stdscr, "", default_host, "")
            if isinstance(res, list):
                ins = sel + 1 if entries else 0
                entries.insert(ins, res)
                sel = ins
            elif isinstance(res, str):
                msg = res
        elif ch == ord('d') and entries:
            entries.pop(sel)
            sel = min(sel, max(0, len(entries) - 1))

curses.wrapper(main)
PYTHON
    python3 "$tmp" "$CONFIG_FILE"
    local rc=$?
    rm -f "$tmp"
    return $rc
}

# ── dispatch ──────────────────────────────────────────────────────────────────

_migrate_config

case "${1:-status}" in
    start)   cmd_start   ;;
    stop)    cmd_stop    ;;
    status)  cmd_status  ;;
    restart) cmd_restart ;;
    edit)    cmd_edit    ;;
    logs)    cmd_logs    ;;
    *)
        echo "usage: tunnel {start|stop|status|restart|edit|logs}"
        exit 1
        ;;
esac
